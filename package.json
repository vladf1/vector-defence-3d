{
  "name": "vector-defence-browser",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "npm": ">=10.8.2"
  },
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "dev": "npm run wasm && vite",
    "check:runtime": "node scripts/check-runtime.mjs",
    "test:rust": "cargo test --locked --workspace",
    "rust:clippy": "cargo clippy --locked --workspace --all-targets -- -D warnings && cargo clippy --locked --target wasm32-unknown-unknown -p vd-web -- -D warnings",
    "render:levels": "node scripts/render-levels.mjs",
    "render:3d": "node scripts/render-3d-board.mjs",
    "benchmark:3d": "node scripts/benchmark-3d-renderer.mjs",
    "benchmark:3d:startup": "node scripts/benchmark-3d-startup.mjs",
    "benchmark:compare": "node scripts/benchmark-compare.mjs",
    "build": "npm run wasm && svelte-check --tsconfig ./tsconfig.json --tsgo && vite build",
    "build:pages": "npm run wasm && svelte-check --tsconfig ./tsconfig.json --tsgo && vite build --base=/vector-defence-3d/",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "playwright": "^1.62.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "typescript": "^6.0.3",
    "vite": "^8.2.0"
  }
}
